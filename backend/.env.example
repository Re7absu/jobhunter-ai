# ---------------------------------------------------------------------------
# JobHunter AI backend configuration. Copy to `.env` and fill in.
# NEVER commit .env. API keys are only read by the backend, never the frontend.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
APP_ENV=development
# PostgreSQL (production). pg8000 is the pure-Python driver.
DATABASE_URL=postgresql+pg8000://jobhunter:jobhunter@localhost:5432/jobhunter
# Local fallback for quick tries without Postgres:
# DATABASE_URL=sqlite:///./jobhunter.db

# JWT signing secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Fernet key that encrypts CV files and Gmail tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Allow creating more accounts after the first one (first account can always be created)
ALLOW_REGISTRATION=false

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
STORAGE_DIR=./storage
MAX_CV_MB=10
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# --- AI (OpenAI) ----------------------------------------------------------
# Needed for LLM CV extraction, matching, email writing, company research.
# Without it the system falls back to deterministic heuristics (clearly labelled).
# Any OpenAI-compatible provider works. Examples:
#   OpenAI (paid):  OPENAI_MODEL=gpt-4.1-mini            OPENAI_BASE_URL=https://api.openai.com/v1
#   Groq (free):    OPENAI_MODEL=openai/gpt-oss-120b     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Gemini (free):  OPENAI_MODEL=gemini-2.5-flash        OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Job discovery ----------------------------------------------------------
# JSearch on RapidAPI (aggregates Google for Jobs: LinkedIn, GulfTalent, Jooble, Tanqeeb, ...)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com
JSEARCH_PATH=/search-v2
# SerpAPI Google Jobs engine — https://serpapi.com/google-jobs-api
SERPAPI_KEY=
# Company boards (Greenhouse, Lever, Ashby, Workable, SmartRecruiters) and career pages need no key.
# Identify the crawler politely when reading company career pages
HTTP_USER_AGENT=JobHunterAI/1.0 (personal job-search assistant)
# Minimum seconds between requests to the same website (robots.txt Crawl-delay wins if larger)
CRAWL_MIN_DELAY_SECONDS=1.0

# --- Gmail API (OAuth 2.0) ------------------------------------------------
# Google Cloud Console → APIs & Services → enable "Gmail API" → OAuth client (Web application)
# Authorized redirect URI must equal GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
